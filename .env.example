# Optional: Compose starts without this file. Never commit the filled .env.
# Host port for DBeaver. PostGIS is bound to localhost only.
POSTGRES_PORT=5432
# OpenAI-compatible protocol: OpenRouter, LM Studio, vLLM, llama.cpp or Ollama /v1.
LLM_PROVIDER=openai
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=
LLM_MODEL=
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
# Set LLM_API_KEY to your key and LLM_MODEL to an available provider/model ID.
# Choose a model/provider supporting strict JSON Schema structured output.
# Local OpenAI-compatible: keep provider=openai, set server port and loaded model ID.
# host.docker.internal reaches your host from Docker; use localhost for a host-run API.
# Native Ollama: LLM_PROVIDER=ollama, LLM_BASE_URL=http://host.docker.internal:11434
# No /v1 suffix for the native Ollama protocol.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OVERPASS_URL=https://overpass-api.de/api/interpreter
